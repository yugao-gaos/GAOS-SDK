{
  "name": "@yugao-gaos/turn-based-grid-sdk",
  "version": "0.22.0",
  "description": "Deterministic game mechanisms and multiplayer infrastructure for agent-ready games.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.3"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "gaos": "./dist/gaos.js",
    "gaos-agent": "./dist/gaos-agent.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "import": "./dist/session.js"
    },
    "./session-host": {
      "types": "./dist/session-host.d.ts",
      "import": "./dist/session-host.js"
    },
    "./ecosystem": {
      "types": "./dist/ecosystem.d.ts",
      "import": "./dist/ecosystem.js"
    },
    "./seat-control": {
      "types": "./dist/seat-control.d.ts",
      "import": "./dist/seat-control.js"
    },
    "./benchmark": {
      "types": "./dist/benchmark.d.ts",
      "import": "./dist/benchmark.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    },
    "./agent-cli": {
      "types": "./dist/agent-cli/index.d.ts",
      "import": "./dist/agent-cli/index.js"
    },
    "./schemas/gaos.replay-v1.schema.json": "./schemas/gaos.replay-v1.schema.json",
    "./fixtures/replay/gaos-replay-v1.golden.jsonl": "./fixtures/replay/gaos-replay-v1.golden.jsonl",
    "./fixtures/replay/gaos-replay-v1.3-ended.golden.jsonl": "./fixtures/replay/gaos-replay-v1.3-ended.golden.jsonl",
    "./fixtures/commitment/gaos.commit.sha256.v1.vectors.json": "./fixtures/commitment/gaos.commit.sha256.v1.vectors.json",
    "./fixtures/signatures/gaos.submission.ed25519.v1.vectors.json": "./fixtures/signatures/gaos.submission.ed25519.v1.vectors.json",
    "./fixtures/dmath/dmath-1.vectors.json": "./fixtures/dmath/dmath-1.vectors.json",
    "./schemas/gaos.presentation-frame-v1.schema.json": "./schemas/gaos.presentation-frame-v1.schema.json",
    "./schemas/gaos.benchmark-manifest-v1.schema.json": "./schemas/gaos.benchmark-manifest-v1.schema.json",
    "./fixtures/ecosystem/presentation-frame-v1.golden.json": "./fixtures/ecosystem/presentation-frame-v1.golden.json"
  },
  "files": [
    "dist",
    "schemas",
    "fixtures",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "dmath:evidence": "npm run build && node scripts/generate-dmath-evidence.mjs",
    "dmath:browsers": "npm run build && node scripts/check-dmath-browsers.mjs",
    "dmath:workerd": "npm run build && node scripts/check-dmath-workerd.mjs",
    "signatures:benchmark": "npm run build && node scripts/benchmark-signatures.mjs",
    "observations:benchmark": "npm run build && node scripts/benchmark-observation-codec.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yugao-gaos/GAOS-TurnBasedGrid-SDK.git"
  },
  "bugs": {
    "url": "https://github.com/yugao-gaos/GAOS-TurnBasedGrid-SDK/issues"
  },
  "homepage": "https://yugao-gaos.github.io/GAOS-TurnBasedGrid-SDK/",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "playwright": "^1.62.0",
    "typescript": "^5.5.4",
    "vitepress": "1.6.4",
    "vitest": "^3.2.7",
    "workerd": "^1.20260724.1"
  },
  "overrides": {
    "vite": "6.4.3"
  }
}
