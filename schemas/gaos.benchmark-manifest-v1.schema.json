{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaos.dev/schemas/gaos.benchmark-manifest-v1.schema.json",
  "title": "GAOS benchmark manifest v1",
  "type": "object",
  "required": ["schema", "schemaVersion", "benchmark", "tasks", "scoring", "submission"],
  "properties": {
    "schema": { "const": "gaos.benchmark-manifest" },
    "schemaVersion": { "const": "1.0" },
    "benchmark": {
      "type": "object",
      "required": ["id", "version", "adapter"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "adapter": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "seeds", "episodes", "maxSteps"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "seeds": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
          },
          "episodes": { "type": "integer", "minimum": 1 },
          "maxSteps": { "type": "integer", "minimum": 1 },
          "weight": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "scoring": {
      "type": "object",
      "required": ["plugin", "aggregation"],
      "properties": {
        "plugin": { "type": "string", "minLength": 1 },
        "aggregation": { "enum": ["mean", "weighted-mean", "sum"] }
      },
      "additionalProperties": false
    },
    "submission": {
      "type": "object",
      "required": ["requireSignedSeats", "requireCompleteCoverage"],
      "properties": {
        "requireSignedSeats": { "type": "boolean" },
        "requireCompleteCoverage": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "observationModalities": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "agentInterface": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
