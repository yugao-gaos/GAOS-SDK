{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/yugao-gaos/GAOS-TurnBasedGrid-SDK/v0.25.0/schemas/gaos.verifier-kit-v1.schema.json",
  "title": "GAOS verifier kit manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "game", "adapter", "runtime", "replayFormats", "files"],
  "properties": {
    "schema": { "const": "gaos.verifier-kit.v1" },
    "game": { "$ref": "#/$defs/identity" },
    "adapter": { "$ref": "#/$defs/adapterIdentity" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "gaosVersion", "nodeRange"],
      "properties": {
        "kind": { "const": "node-esm" },
        "gaosVersion": { "type": "string", "minLength": 1 },
        "nodeRange": { "type": "string", "minLength": 1 }
      }
    },
    "replayFormats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "digest"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          },
          "size": { "type": "integer", "minimum": 0 },
          "digest": { "$ref": "#/$defs/digest" }
        }
      }
    }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "adapterIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "entrypoint"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "entrypoint": { "const": "adapter.bundle.mjs" }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
