{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaos.dev/schemas/gaos.dynamic-control-evidence-v2.schema.json",
  "title": "GAOS dynamic-controller evidence v2",
  "type": "object",
  "required": ["format", "sessionId", "checkpoint", "commands"],
  "properties": {
    "format": { "const": "gaos.dynamic-control-evidence.v2" },
    "sessionId": { "type": "string", "minLength": 1 },
    "checkpoint": {
      "type": "object",
      "required": ["format", "sessionId", "control", "signatureStates"],
      "properties": {
        "format": { "const": "gaos.dynamic-control-checkpoint.v2" },
        "sessionId": { "type": "string", "minLength": 1 },
        "control": { "type": "object" },
        "signatureStates": { "$ref": "#/$defs/signatureStates" }
      },
      "additionalProperties": false
    },
    "commands": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "signatureStates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["seat", "epoch", "genesisHash", "lastChainHead"],
        "properties": {
          "seat": { "type": "string", "minLength": 1 },
          "epoch": { "type": "integer", "minimum": 0 },
          "genesisHash": { "type": "string" },
          "lastChainHead": { "type": "string" },
          "lastSignedChainHead": { "type": "string" },
          "lastPeriodicTick": { "type": "integer", "minimum": 0 },
          "lastPeriodicClientTime": { "type": "integer", "minimum": 0 },
          "lastPeriodicSignature": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
