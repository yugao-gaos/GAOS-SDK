{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/yugao-gaos/GAOS-TurnBasedGrid-SDK/v0.17.0/schemas/gaos.replay-v1.schema.json",
  "title": "GAOS portable replay v1",
  "description": "Schema for a decoded gaos.replay v1 artifact. The JSONL transport stores the header first, followed by each action.",
  "type": "object",
  "additionalProperties": false,
  "required": ["header", "actions"],
  "properties": {
    "header": { "$ref": "#/$defs/header" },
    "actions": {
      "type": "array",
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "$defs": {
    "jsonObject": {
      "type": "object",
      "additionalProperties": true
    },
    "gameRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "adapter"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "levelResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "stars", "actionsUsed"],
      "properties": {
        "status": { "enum": ["won", "failed"] },
        "stars": { "type": ["number", "null"] },
        "actionsUsed": { "type": "integer", "minimum": 0 },
        "extensions": { "$ref": "#/$defs/jsonObject" }
      }
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "id", "seed", "level", "result"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": ["string", "number"] },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "level": true,
        "result": { "$ref": "#/$defs/levelResult" },
        "extensions": { "$ref": "#/$defs/jsonObject" }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalStars", "totalActionsUsed"],
      "properties": {
        "totalStars": { "type": "number" },
        "totalActionsUsed": { "type": "integer", "minimum": 0 },
        "extensions": { "$ref": "#/$defs/jsonObject" }
      }
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "format",
        "formatVersion",
        "sessionId",
        "game",
        "seed",
        "seedPolicy",
        "perm",
        "levels",
        "totals"
      ],
      "properties": {
        "kind": { "const": "header" },
        "format": { "const": "gaos.replay" },
        "formatVersion": { "const": "1.0" },
        "sessionId": { "type": "string", "minLength": 1 },
        "game": { "$ref": "#/$defs/gameRef" },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "seedPolicy": {
          "enum": ["explicit", "gaos.run-level-seed.v1"]
        },
        "perm": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "uniqueItems": true
        },
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/level" }
        },
        "totals": { "$ref": "#/$defs/totals" },
        "visibility": {
          "anyOf": [
            { "const": "full" },
            { "type": "string", "pattern": "^seat:.+" }
          ]
        },
        "extensions": { "$ref": "#/$defs/jsonObject" }
      }
    },
    "locationRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["container", "coord"],
      "properties": {
        "container": { "type": "string", "minLength": 1 },
        "coord": {
          "oneOf": [
            {
              "type": "array",
              "prefixItems": [
                { "type": "integer" },
                { "type": "integer" }
              ],
              "items": false
            },
            { "type": "string" },
            { "type": "integer" }
          ]
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "n", "levelIndex", "wireId", "canonicalId"],
      "properties": {
        "kind": { "const": "action" },
        "n": { "type": "integer", "minimum": 0 },
        "levelIndex": { "type": "integer", "minimum": 0 },
        "wireId": {
          "type": "string",
          "pattern": "^Action [1-9][0-9]*$"
        },
        "canonicalId": {
          "type": "string",
          "pattern": "^Action [1-9][0-9]*$"
        },
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "index": { "type": "integer" },
        "boardId": { "type": "string", "minLength": 1 },
        "zoneId": { "type": "string", "minLength": 1 },
        "seat": { "type": "string", "minLength": 1 },
        "targets": {
          "type": "array",
          "items": { "$ref": "#/$defs/locationRef" }
        },
        "tick": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
